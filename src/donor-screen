#!/usr/bin/env python3
"""Run the v0.2 donor screen with native KING, Beagle and RZooRoH."""
import argparse
import csv
import gzip
import hashlib
import itertools
import json
import math
import os
from pathlib import Path
import subprocess
import shutil
import sys

from build_panel import build_panel, DIPLOID, MISSING
from report import write_report
from build_coding_pairs import build as build_coding_pairs, coding_panel


def table(path, columns):
    with path.open(encoding="utf-8-sig") as f:
        reader = csv.DictReader(f, delimiter="\t")
        if not set(columns).issubset(reader.fieldnames or []):
            raise ValueError(f"{path}: required columns {columns}")
        yield from reader


def vcf(path, expected):
    with gzip.open(path, "rt") as f:
        ids = None
        for line in f:
            if line.startswith("##"):
                continue
            fields = line.rstrip("\r\n").split("\t")
            if line.startswith("#CHROM"):
                ids = fields[9:]
                if set(ids) != set(expected) or len(ids) != len(expected):
                    raise ValueError(f"Unexpected VCF samples in {path}")
                order = [ids.index(x) for x in expected]
                continue
            if ids is None or len(fields) != len(ids) + 9 or fields[8].split(":")[0] != "GT":
                raise ValueError(f"Invalid GT-first VCF: {path}")
            site = (fields[0], fields[1], fields[3], fields[4])
            if site[2] not in "ACGT" or site[3] not in "ACGT" or len(site[2]) != 1 or len(site[3]) != 1 or site[2] == site[3]:
                raise ValueError(f"Expected diploid biallelic SNP: {site}")
            yield site, [fields[9+i].split(":")[0] for i in order]
        if ids is None:
            raise ValueError(f"Missing header: {path}")


def run(args):
    source, samples = args.vcf.resolve(strict=True), args.samples.resolve(strict=True)
    out = args.out.resolve()
    jar = args.beagle_jar.resolve(strict=True)
    if args.r_policy and not (args.cds_sites or args.cds_panel):
        raise ValueError("--r-policy requires --cds-sites or --cds-panel")
    annotation = (args.cds_sites or args.cds_panel)
    if annotation is not None:
        annotation = annotation.resolve(strict=True)
    if args.froh_bed:
        args.froh_bed = args.froh_bed.resolve(strict=True)
        if not shutil.which("plink"):
            raise ValueError("Predicted FROH requires PLINK 1.9")
    elif args.froh_replicates != 100 or args.froh_seed != 50483 or args.froh_chr_set != 95:
        raise ValueError("FROH settings require --froh-bed")
    if args.froh_replicates < 2:
        raise ValueError("--froh-replicates must be at least 2")
    if args.threads < 1:
        raise ValueError("--threads must be positive")
    with samples.open(encoding="utf-8-sig") as f:
        meta = {}
        rows = []
        for line in f:
            if line.startswith("#"):
                key, sep, value = line[1:].strip().partition("=")
                if sep:
                    if key in meta:
                        raise ValueError(f"Duplicate sample-sheet setting: {key}")
                    meta[key] = value.strip()
            elif line.strip():
                rows.append(line)
        people = list(csv.DictReader(rows, delimiter="\t"))
    ids = [p["sample"] for p in people]
    if not ids or len(set(ids)) != len(ids) or any(not x or any(c.isspace() or c in ",<>" for c in x) for x in ids):
        raise ValueError("Sample IDs must be unique and contain no whitespace or commas")
    if any(p["role"] not in {"donor","recipient","reference"} for p in people):
        raise ValueError("Roles: donor, recipient, reference")
    rec = [p["sample"] for p in people if p["role"] == "recipient"]
    don = [p["sample"] for p in people if p["role"] == "donor"]
    n = args.offspring
    kmax = args.donors or args.max_donors or min(n,len(don))
    if len(rec) < 2*n or not 1 <= kmax <= min(n,len(don)):
        raise ValueError("Need two recipients per F1 for the no-introduction control and enough donors")
    chroms = meta["autosomes"].split(",")
    bp = int(meta["reference_bp"])
    if not chroms or any(not c or any(x.isspace() for x in c) for c in chroms) or len(set(chroms)) != len(chroms) or bp < 1:
        raise ValueError("Specify valid #autosomes and #reference_bp")
    if args.king_vcf:
        king = args.king_vcf.resolve(strict=True)
    elif meta.get("king_panel") == "joint":
        king = source
    else:
        raise ValueError("Provide --king-vcf with the adopted KING SNP panel or explicitly set #king_panel=joint")
    for tool in ('bcftools', 'plink2', 'java', 'Rscript'):
        if not shutil.which(tool):
            raise ValueError(f'Required command not found in PATH: {tool}')
    out.mkdir(exist_ok=False)
    scripts = Path(__file__).resolve().parent
    (out/"samples.txt").write_text("\n".join(ids)+"\n",encoding="utf-8")
    def command(*tokens, label):
        cmd = [str(x) for x in tokens]
        with (out/(label+".log")).open("w",encoding="utf-8") as log:
            print(json.dumps(cmd),file=log,flush=True)
            subprocess.run(cmd,cwd=out,stdout=log,stderr=subprocess.STDOUT,check=True)
    def subset(infile, dest):
        command("bcftools","view","-S","samples.txt","-t",",".join(chroms),
                "-Oz","-o",dest,infile,label=dest+".subset")
    subset(source,"joint.vcf.gz")
    subset(king,"king.vcf.gz")
    joint = out/"joint.vcf.gz"
    h = [0]*len(ids)
    seen = set()
    for site, genotypes in vcf(joint,ids):
        seen.add(site[0])
        for i, gt in enumerate(genotypes):
            if gt in DIPLOID:
                h[i] += DIPLOID[gt] == 1
            elif gt not in MISSING:
                raise ValueError(f"Invalid diploid genotype {gt}: {site}")
    if set(chroms) != seen or max(h) > bp:
        raise ValueError("Autosome list and reference length must match the analysis scope")
    command("plink2","--vcf","king.vcf.gz","--double-id","--chr-set",95,"no-xy","no-mt",
            "--allow-extra-chr","--make-king-table","--threads",args.threads,"--out","king",label="king.run")
    parent = {x:x for x in ids}
    def root(x):
        while x != parent[x]:
            x = parent[x]
        return x
    values = {}
    with (out/"king.kin0").open() as f:
        header = f.readline().lstrip("#").split()
        for line in f:
            data = dict(zip(header,line.split(),strict=True))
            a,b = sorted((data.get("IID1", data.get("ID1")), data.get("IID2", data.get("ID2"))))
            if a not in parent or b not in parent:
                raise ValueError("Unrecognized KING sample ID")
            value = float(data["KINSHIP"] if "KINSHIP" in data else data["Kinship"])
            if a == b or (a,b) in values or not math.isfinite(value):
                raise ValueError("Invalid KING pair")
            values[a,b] = value
            if value > .177:
                ra,rb = sorted((root(a),root(b)))
                parent[rb] = ra
    if len(values) != len(ids)*(len(ids)-1)//2:
        raise ValueError("Incomplete KING matrix")
    command("java","-Xmx"+args.java_memory,"-jar",jar,"gt=joint.vcf.gz","out=phased",
            "seed=50483",f"nthreads={args.threads}",label="beagle.run")
    prefix = out/"hbd"
    with (out/"hbd.haps").open("w") as hap, (out/"hbd.freq").open("w") as freq:
        for original, phased in itertools.zip_longest(vcf(joint,ids), vcf(out/"phased.vcf.gz",ids)):
            if original is None or phased is None or original[0] != phased[0]:
                raise ValueError("Phasing changed the site panel")
            (chrom,pos,ref,alt), raw = original
            phases = phased[1]
            known = [DIPLOID[x] for x in raw if x in DIPLOID]
            if not known or any(gt not in {"0|0","0|1","1|0","1|1"} for gt in phases):
                raise ValueError(f"Missing phased data or no observed alleles at {chrom}:{pos}")
            if any(x in DIPLOID and DIPLOID[x] != DIPLOID[y] for x,y in zip(raw,phases)):
                raise ValueError(f"Observed genotype changed at {chrom}:{pos}")
            print(format(sum(known)/(2*len(known)),'.17g'),file=freq)
            print(chrom,f"{chrom}:{pos}:{ref}:{alt}",pos,ref,alt,
                  *(g for phase in phases for g in phase.split("|")),file=hap)
    (out/"hbd.samples").write_text("".join(f"S{i:06d}\n" for i in range(1,len(ids)+1)))
    indices = {x:i for i,x in enumerate(ids,1)}
    pairs = sorted(tuple(sorted(p)) for p in itertools.chain(itertools.combinations(rec,2),itertools.product(rec,don)))
    eligible = [p for p in pairs if values[p] <= .177]
    if not eligible:
        raise ValueError("No allowable pairs")
    with (out/"hbd.pairs").open("w") as f:
        print("i\tj",file=f)
        for a,b in eligible:
            print(*sorted((indices[a],indices[b])),sep="\t",file=f)
    command("Rscript",scripts/"donor_hbd.R",prefix,label="hbd.run")
    predicted = [float(x) for x in (out/"hbd.values").read_text().splitlines()]
    if len(predicted) != len(eligible) or not all(0<=x<=1 for x in predicted):
        raise ValueError("Incomplete or invalid HBD output")
    hbd = dict(zip(eligible,predicted))
    cfg = dict(export_pairwise=True,cohort=out.name,offspring_count=n,max_donors=kmax,
        individuals=[dict(sample=x,role="recipient" if x in rec else "candidate",cluster=root(x),h=h[indices[x]-1]/bp)
                     for x in rec+don],
        pairs=[dict(a=a,b=b,allowed=(a,b) in hbd,king=values[a,b],hbd=hbd.get((a,b),1.0)) for a,b in pairs],
        reference_samples=ids,chromosomes=chroms,rare_file="rare.tsv.gz",het_file="het.tsv")
    conf = out/"config.json"
    if annotation is not None:
        cfg.update(missense_file="coding-pairs.tsv", missense_policy=args.r_policy or "report")
    if args.donors is not None:
        cfg["donor_count"] = args.donors
    conf.write_text(json.dumps(cfg,indent=2),encoding="utf-8")
    if annotation is not None:
        panel = annotation
        if args.cds_sites:
            panel = out / "coding-sites.tsv"
            observed = ((site, [DIPLOID.get(genotypes[indices[s] - 1]) for s in rec + don])
                        for site, genotypes in vcf(joint, ids))
            coding_panel(annotation, observed, rec + don, panel)
        build_coding_pairs(panel, conf, out / "coding-pairs.tsv")
    build_panel(conf,joint)
    command(sys.executable,scripts/"screen.py",conf,"results.json","--csv","results.csv",label="screen.run")
    section = ""
    if args.froh_bed:
        from predict_roh import predict, report_section

        output = out / "results.json"
        data = json.loads(output.read_text(encoding="utf-8"))
        summary = predict(data, vcf(out / "phased.vcf.gz", ids), ids, args.froh_bed,
                          args.froh_chr_set, out / "04_predicted_froh",
                          args.froh_replicates, args.froh_seed,
                          extra_genotypes=lambda: vcf(out / "phased.vcf.gz", ids))
        data["predicted_froh"] = dict(replicates_per_pair=args.froh_replicates,
                                     seed=args.froh_seed, all_recipient_donor_pairs=True, recombination_cm_per_mb=1,
                                     chromosomes=chroms, plink_chr_set=args.froh_chr_set,
                                     bed_sha256=hashlib.sha256(args.froh_bed.read_bytes()).hexdigest(),
                                     plans=summary)
        output.write_text(json.dumps(data, ensure_ascii=False, indent=2), encoding="utf-8")
        section = report_section(summary, args.froh_replicates, args.froh_seed)
    write_report(out, extra_section=section)
    print(out/"results.csv")
    print(out/"report.html")


def main():
    cli = argparse.ArgumentParser(description=__doc__, epilog="Run donor-screen froh --help for observed FROH.")
    cli.add_argument("vcf",type=Path)
    cli.add_argument("samples",type=Path)
    cli.add_argument("--out",type=Path,required=True)
    cli.add_argument("--beagle-jar",type=Path,default=os.getenv("BEAGLE_JAR"),
                     required=not os.getenv("BEAGLE_JAR"))
    cli.add_argument("--king-vcf",type=Path)
    coding = cli.add_mutually_exclusive_group()
    coding.add_argument("--cds-sites", type=Path, help="Curated, allele-matched CDS annotations (TSV or TSV.GZ)")
    coding.add_argument("--cds-panel", type=Path, help="Curated CDS sites with recipient and donor ALT dosages")
    cli.add_argument("--r-policy", choices=("report", "reference", "baseline"),
                     help="Report R or apply the existing high-heterozygosity or no-introduction R limit")
    cli.add_argument("--froh-bed", type=Path, help="Whole-autosome BED enabling predicted F1 FROH")
    cli.add_argument("-r","--froh-replicates", type=int, default=100, help="Simulated offspring per pair (default: 100)")
    cli.add_argument("--froh-seed", type=int, default=50483, help="Reproducible FROH simulation seed")
    cli.add_argument("--froh-chr-set", type=int, default=95, help="PLINK autosome count for the VCF (default: 95)")
    cli.add_argument("-n", "--offspring", type=int, choices=(1,2,3), default=3,
                     help="F1 slots per plan (default: 3)")
    quota = cli.add_mutually_exclusive_group()
    quota.add_argument("-k", "--donors", type=int, choices=(1,2,3),
                       help="Evaluate exactly this many donors, plus the no-introduction control")
    quota.add_argument("--max-donors", type=int, choices=(1,2,3),
                       help="Evaluate every donor count up to this number")
    cli.add_argument("-t", "--threads", type=int, default=4,
                     help="Threads for PLINK 2 KING and Beagle phasing (default: 4)")
    cli.add_argument("--java-memory",default="16g")
    try:
        run(cli.parse_args())
    except (OSError, ValueError, KeyError, subprocess.CalledProcessError) as err:
        cli.exit(1,f"donor-screen: {err}\n")


if __name__ == "__main__":
    if sys.argv[1:2] == ["froh"]:
        from observed_roh import main as observed_roh_main

        observed_roh_main(sys.argv[2:])
    else:
        main()
